1(a) Depth First Search — DFS 

import collections

def dfs(gr, n, seen, d):
    if n in seen:
        return seen

    seen.append(n)

    for i in gr[n]:
        if i == d:
            seen.append(i)
            break

        if i not in seen:
            dfs(gr, i, seen, d)

    return seen


